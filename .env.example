# 手动构建镜像时使用的上游源码。
VIBE_ASTOCK_REPO=https://github.com/simonlin1212/vibe-astock.git
VIBE_ASTOCK_REF=main

# Compose 默认使用发布到 GHCR 的镜像。
IMAGE_NAME=ghcr.io/matrixhawk/vibe-astock-docker:latest
HOST_PORT=5898

# 容器内服务配置。
UVICORN_WORKERS=1
VR_API_KEY=
VR_ALLOW_ORIGINS=*
VIBE_ALLOW_HOSTS=
VIBE_MARKET_PROXY=
VIBE_MARKET_DIRECT=

# 可选：LLM 与题材分析配置。不要把真实密钥提交到 Git。
# 默认将宿主机 $HOME/.config/mimo 只读挂载到容器，目录内应有 mimo.env。
# 凭据目录在其他位置时填写绝对路径；也可以直接设置下面的 MIMO_* 环境变量。
MIMO_CONFIG_DIR=
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL=
IWENCAI_API_KEY=

# 发布镜像默认使用 GHCR；本地构建时可改成 vibe-astock:local。
IMAGE_NAME=ghcr.io/matrixhawk/vibe-astock-docker:latest
HOST_PORT=5898

# 上游跟随参数只供 scripts/build.sh 使用；Compose 不会重新构建镜像。
VIBE_ASTOCK_REPO=https://github.com/simonlin1212/vibe-astock.git
VIBE_ASTOCK_REF=main

# 容器运行参数。
VRA_LAN=1
VRA_SCHEDULER=on
# 留空时首次启动自动生成并保存到数据卷 /data/.local/api.token。
VRA_API_TOKEN=
# 默认关闭。开启后页面需要带 VRA_ACCESS_TOKEN 的访问链接。
VRA_REMOTE=
VRA_ACCESS_TOKEN=
VRA_PUBLIC_URL=

# 后台默认 AI 来源，可填 mimo、deepseek、kimi、glm、qwen、openai-api、selfhosted 等。
# 也可以不填，直接在 WebUI「接入 AI」中选择并配置。
VRA_PROVIDER=
DEEPSEEK_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
MIMO_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
SELFHOSTED_API_KEY=
